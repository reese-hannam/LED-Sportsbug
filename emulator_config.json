{
  "pixel_size": 8,
  "pixel_style": "square",
  "pixel_glow": 6,
  "display_adapter": "browser",
  "suppress_adapter_load_errors": false,
  "browser": {
    "_comment": "Open http://localhost:8888 to see the panel.",
    "port": 8888,
    "target_fps": 30,
    "fps_display": false,
    "quality": 90,
    "image_border": true,
