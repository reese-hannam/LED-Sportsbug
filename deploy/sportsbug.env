# Panel hardware settings, installed to /etc/default/sportsbug.
#
# These describe one physical build, so they live here rather than in the code:
# edit this file and `sudo systemctl restart sportsbug` -- no checkout needed,
# and an upgrade of the app won't overwrite your wiring.
#
# The defaults below are the ones VERIFIED WORKING on this build:
# SEENGREAT RGB Matrix Adapter Rev 3.0 + P3 64x64 panels with FM6126A drivers.

# Panel driver chip. FM6126A panels ignore all data until they get a register
# init sequence -- with the wrong value here the panel stays COMPLETELY BLACK
# while every log line reports success. Set empty for ordinary panels.
MATRIX_PANEL_TYPE=FM6126A

# Pinout. "regular" is the plain Pi GPIO layout used by the SEENGREAT board.
# Use adafruit-hat (or adafruit-hat-pwm, which needs a GPIO4-GPIO18 jumper)
# only on genuine Adafruit hardware.
MATRIX_MAPPING=regular

# Timing. Raise if the panel sparkles or ghosts, lower for a faster refresh.
# 1-2 suits a Pi Zero 2; 4 suits a Pi 4.
MATRIX_SLOWDOWN=2

# Geometry: two 64x64 panels chained into one 128x64 canvas.
MATRIX_ROWS=64
MATRIX_COLS=64
MATRIX_CHAIN=2
MATRIX_PARALLEL=1

# Last-resort fallback if the onboard sound module can't be disabled. Costs
# visible flicker, so prefer fixing the sound blacklist. Uncomment to enable:
# MATRIX_NO_HW_PULSE=1
